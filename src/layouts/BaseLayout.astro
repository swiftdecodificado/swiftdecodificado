---
import '../styles/site.css';
import SiteFooter from '../components/layout/SiteFooter.astro';
import SiteHeader from '../components/layout/SiteHeader.astro';
import { site, ui, type Language } from '../config/site';

interface Props {
  title: string;
  description: string;
  language: Language;
  canonical?: string | null;
  alternates?: { language: string; url: string }[];
  ogType?: string;
  coverUrl?: string;
  coverAlt?: string;
  isHome?: boolean;
  isArticle?: boolean;
  isAbout?: boolean;
  isTrailPage?: boolean;
  draft?: boolean;
  noindex?: boolean;
  published?: Date;
  modified?: Date;
  tags?: string[];
  diagramStyles?: string[];
}

const {
  title,
  description,
  language,
  canonical: canonicalProp,
  alternates = [],
  ogType = 'website',
  coverUrl,
  coverAlt,
  isHome = false,
  isArticle = false,
  isAbout = false,
  isTrailPage = false,
  draft = false,
  noindex = false,
  published,
  modified,
  tags = [],
  diagramStyles = [],
} = Astro.props;
const canonical =
  canonicalProp === null ? undefined : (canonicalProp ?? new URL(Astro.url.pathname, site.origin).toString());
const text = ui[language];
const socialImage = coverUrl ? new URL(coverUrl, site.origin).toString() : `${site.origin}/og-default.png`;
const titleText = isHome ? title : `${title} · ${site.name}`;
---

<!doctype html>
<html lang={language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titleText}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {alternates.map((alternate) => (
      <link rel="alternate" hreflang={alternate.language} href={alternate.url} />
    ))}
    {(draft || noindex) && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={coverAlt ?? `${site.name} · ${site.brand}`} />
    <meta property="og:locale" content={language === 'en' ? 'en_US' : 'pt_BR'} />
    {alternates.some((alternate) => alternate.language !== language) && (
      <meta property="og:locale:alternate" content={language === 'en' ? 'pt_BR' : 'en_US'} />
    )}
    <meta name="author" content={site.author} />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    {coverAlt && <meta name="twitter:image:alt" content={coverAlt} />}
    {isArticle && !draft && published && (
      <meta property="article:published_time" content={published.toISOString().slice(0, 10)} />
    )}
    {isArticle && !draft && tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {!draft && diagramStyles.map((href) => <link rel="stylesheet" href={href} />)}
    {isArticle && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify({
          '@context': 'https://schema.org',
          '@type': 'BlogPosting',
          headline: title,
          description,
          inLanguage: language,
          datePublished: published?.toISOString().slice(0, 10),
          dateModified: (modified ?? published)?.toISOString().slice(0, 10),
          author: { '@type': 'Person', name: site.author, url: new URL(text.aboutUrl, site.origin).toString() },
          mainEntityOfPage: canonical ?? new URL(Astro.url.pathname, site.origin).toString(),
          image: socialImage,
        }).replace(/<\//g, '<\\/')}
      />
    )}
  </head>
  <body
    class:list={[{ 'page-article': isArticle, 'page-list': isHome || isAbout || isTrailPage, 'page-home': isHome }]}
  >
    <SiteHeader
      language={language}
      alternates={alternates}
      isArticle={isArticle}
      isTrailPage={isTrailPage}
      isAbout={isAbout}
    />
    <main id="main" class="shell" tabindex="-1">
      <slot />
    </main>
    <SiteFooter language={language} />
    <script>
      import '../scripts/site.js';
    </script>
  </body>
</html>
