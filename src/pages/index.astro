---
import { getCollection } from 'astro:content';
import ContentPage from '../components/shared/ContentPage.astro';

const entries = await getCollection('sitePages', ({ data }) => data.isHome === true && data.language === 'pt-BR');
const entry = entries[0];
if (!entry) throw new Error('Portuguese home page not found in the sitePages collection.');
---

<ContentPage entry={entry} />
